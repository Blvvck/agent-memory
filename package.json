{
  "name": "@daimones/agent-memory",
  "version": "0.1.2",
  "description": "Persistent memory and a reusable body structure for AI agents",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "llm",
    "memory",
    "persistent-memory",
    "context",
    "agent-memory",
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "cursor",
    "cli",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blvvck/agent-memory.git"
  },
  "homepage": "https://github.com/Blvvck/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Blvvck/agent-memory/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-memory": "dist/init.js",
    "agent-memory-heartbeat": "dist/heartbeat.js",
    "agent-log": "dist/agent-log.js",
    "trace-search": "dist/trace-search.js",
    "agent-session": "dist/current-session.js"
  },
  "files": [
    ".agents/",
    "AGENTS.md",
    "dist/",
    "examples/",
    "protocols/",
    "README.md",
    "postinstall.mjs",
    "settings.example.json",
    "codex-hooks.example.json",
    "antigravity-hooks.example.json",
    "cursor-hooks.example.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/mark-bins.mjs",
    "test": "npm run build && node --test tests/protected-log-guard.test.cjs tests/work-log.test.cjs tests/scaffold.test.cjs tests/wake.test.cjs tests/wake-harnesses.test.cjs tests/bins.test.cjs tests/init.test.cjs tests/snapshot-claim.test.cjs tests/human-import.test.cjs",
    "postinstall": "node postinstall.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  }
}
