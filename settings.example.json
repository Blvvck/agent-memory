{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/wake.js",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_pre_tool --name guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_pre_tool --name trace-write-intent --script ~/.agent-memory/dist/hooks/core/trace-write-intent.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_pre_tool --name spawn-check --script ~/.agent-memory/dist/hooks/core/agent-spawn-check.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|Task|WebFetch|WebSearch|ToolSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_post_tool --name cache-session-id --script ~/.agent-memory/dist/hooks/harnesses/claude-code/cache-session.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|Task|WebFetch|WebSearch|ToolSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_post_tool --name brain-sync --script ~/.agent-memory/dist/hooks/harnesses/claude-code/brain-sync-adapter.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_precompact --name brain-sync --script ~/.agent-memory/dist/hooks/harnesses/claude-code/brain-sync-adapter.js",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_stop --name brain-sync --script ~/.agent-memory/dist/hooks/harnesses/claude-code/brain-sync-adapter.js",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_stop --name trace-stop-check --script ~/.agent-memory/dist/hooks/core/trace-stop-check.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/claude-code/dispatch.js --event claude_session_end --name brain-sync --script ~/.agent-memory/dist/hooks/harnesses/claude-code/brain-sync-adapter.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
