{
  "description": "Agent Memory lifecycle hooks for Codex",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/codex/dispatch.js",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
