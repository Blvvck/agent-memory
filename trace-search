#!/usr/bin/env python3
"""
trace-search: Find related entries in tracked files for bidirectional trace linking.

Usage:
  trace-search <file> <keyword1> [keyword2] [keyword3] ...
  trace-search --multi <file1>:<kw1,kw2> <file2>:<kw3,kw4> ...

Examples:
  trace-search ~/.agent-memory/agents/godel/brain/memory.md "Smart Router" "Sprint 9" "enrichment"
  trace-search --multi memory.md:router,sprint ACTIVITY.md:enrichment,alternatives

Output:
  JSON array of matching entries with line numbers and context.
  Each match includes a suggested trace-forward line to add.

The search is fast (grep-style) and returns entries that match ANY keyword.
For each match, it extracts the entry header (date, agent, session, title)
so you can construct bidirectional trace references.
"""

import argparse
import json
import os
import re
import sys
from pathlib import Path

# Entry header pattern: [YYYY-MM-DD] ... @Agent [session:X]: **Title**
ENTRY_PATTERN = re.compile(
    r'^\s*[-*]?\s*\[(\d{4}-\d{2}-\d{2})\]'  # Date
    r'.*?@(\w+)'                              # Agent
    r'.*?\[session:([^\]]+)\]'                # Session
    r'[:\s]*\*\*([^*]+)\*\*',                 # Title (bold)
    re.MULTILINE
)

# Simpler pattern for entries without bold titles
ENTRY_PATTERN_SIMPLE = re.compile(
    r'^\s*[-*]?\s*\[(\d{4}-\d{2}-\d{2})\]'  # Date
    r'(?:\s*\[[^\]]+\])*'                    # Optional project tag
    r'\s*@(\w+)'                              # Agent
    r'\s*\[session:([^\]]+)\]'                # Session
    r'[:\s]*(.+?)(?:\n|$)',                   # Title (rest of line)
    re.MULTILINE
)


def find_entries(file_path: Path) -> list:
    """Parse a file and extract all entry headers with their positions."""
    content = file_path.read_text(encoding='utf-8')
    entries = []

    # Try both patterns
    for match in ENTRY_PATTERN.finditer(content):
        line_num = content[:match.start()].count('\n') + 1
        entries.append({
            'line': line_num,
            'date': match.group(1),
            'agent': match.group(2),
            'session': match.group(3),
            'title': match.group(4).strip(),
            'start': match.start(),
            'end': match.end(),
            'raw': match.group(0)
        })

    # Also try simpler pattern for entries without bold
    for match in ENTRY_PATTERN_SIMPLE.finditer(content):
        line_num = content[:match.start()].count('\n') + 1
        # Skip if we already have an entry at this line
        if any(e['line'] == line_num for e in entries):
            continue
        title = match.group(4).strip()
        # Clean up title - remove markdown formatting
        title = re.sub(r'\*\*([^*]+)\*\*', r'\1', title)
        title = title.split('.')[0].strip()  # Take first sentence
        if len(title) > 80:
            title = title[:77] + '...'
        entries.append({
            'line': line_num,
            'date': match.group(1),
            'agent': match.group(2),
            'session': match.group(3),
            'title': title,
            'start': match.start(),
            'end': match.end(),
            'raw': match.group(0)
        })

    # Sort by line number
    entries.sort(key=lambda e: e['line'])
    return entries


def search_file(file_path: Path, keywords: list) -> list:
    """Search a file for entries matching any of the keywords."""
    if not file_path.exists():
        return []

    content = file_path.read_text(encoding='utf-8').lower()
    entries = find_entries(file_path)

    # Find entries whose content matches any keyword
    matches = []
    keywords_lower = [kw.lower() for kw in keywords]

    for i, entry in enumerate(entries):
        # Get the entry's full content (until next entry or EOF)
        start = entry['start']
        end = entries[i + 1]['start'] if i + 1 < len(entries) else len(content)
        entry_content = content[start:end]

        # Check if any keyword matches
        matched_keywords = [kw for kw in keywords_lower if kw in entry_content]
        if matched_keywords:
            matches.append({
                'line': entry['line'],
                'date': entry['date'],
                'agent': entry['agent'],
                'session': entry['session'],
                'title': entry['title'],
                'matched_keywords': matched_keywords,
                'trace_ref': f"[{entry['date']}] @{entry['agent']} [session:{entry['session']}]: {entry['title'][:60]}",
                'trace_forward_template': f"  ↪ trace-forward: [DATE] @AGENT [session:SESSION]: NEW_TITLE"
            })

    return matches


def expand_path(path_str: str) -> Path:
    """Expand ~ and resolve relative paths."""
    path = Path(path_str).expanduser()
    if not path.is_absolute():
        # Check common locations
        candidates = [
            Path.home() / '.agent-memory' / 'agents' / 'godel' / 'brain' / path_str,
            Path.home() / '.agent-memory' / 'comms' / path_str,
            Path.cwd() / '.agent-memory' / 'comms' / path_str,
            Path.cwd() / path_str,
        ]
        for candidate in candidates:
            if candidate.exists():
                return candidate
    return path


def main():
    parser = argparse.ArgumentParser(
        description='Search tracked files for related entries to create bidirectional traces.',
        epilog='''
Examples:
  trace-search memory.md "Smart Router" "Sprint 9"
  trace-search ~/.agent-memory/agents/godel/brain/memory.md enrichment alternatives
  trace-search --multi memory.md:router,sprint ACTIVITY.md:enrichment
        '''
    )
    parser.add_argument('--multi', action='store_true',
                        help='Multi-file mode: file1:kw1,kw2 file2:kw3,kw4')
    parser.add_argument('--json', action='store_true',
                        help='Output raw JSON (default is formatted)')
    parser.add_argument('--limit', type=int, default=10,
                        help='Max results per file (default: 10)')
    parser.add_argument('args', nargs='+',
                        help='file keywords... OR --multi file:kw1,kw2 ...')

    args = parser.parse_args()

    results = {}

    if args.multi:
        # Multi-file mode: file1:kw1,kw2 file2:kw3,kw4
        for spec in args.args:
            if ':' not in spec:
                print(f"Error: --multi requires format file:kw1,kw2 — got '{spec}'", file=sys.stderr)
                sys.exit(1)
            file_part, kw_part = spec.split(':', 1)
            keywords = [k.strip() for k in kw_part.split(',') if k.strip()]
            file_path = expand_path(file_part)
            matches = search_file(file_path, keywords)[:args.limit]
            results[str(file_path)] = matches
    else:
        # Single file mode: file keyword1 keyword2 ...
        if len(args.args) < 2:
            print("Error: need at least file and one keyword", file=sys.stderr)
            sys.exit(1)
        file_path = expand_path(args.args[0])
        keywords = args.args[1:]
        matches = search_file(file_path, keywords)[:args.limit]
        results[str(file_path)] = matches

    if args.json:
        print(json.dumps(results, indent=2))
    else:
        # Formatted output
        total = 0
        for file_path, matches in results.items():
            if matches:
                print(f"\n## {file_path} ({len(matches)} matches)")
                print("-" * 60)
                for m in matches:
                    total += 1
                    print(f"\nLine {m['line']}: {m['trace_ref']}")
                    print(f"  Keywords: {', '.join(m['matched_keywords'])}")
                    print(f"  To link this entry to your new entry, add to line {m['line']}:")
                    print(f"    ↪ trace-forward: [NEW_DATE] @[YOUR_AGENT] [session:NEW_SESSION]: [NEW_TITLE]")

        if total == 0:
            print("\nNo matches found.")
        else:
            print(f"\n---\nTotal: {total} related entries found.")
            print("For each match, edit the old entry to add a trace-forward line.")
            print("Then add trace: relates-to lines on your new entry pointing back.")


if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
