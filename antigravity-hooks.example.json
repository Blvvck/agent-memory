{
  "agent-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event SessionStart",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|write_to_file|replace_file_content|multi_replace_file_content|sed_file|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|write_to_file|replace_file_content|multi_replace_file_content|sed_file|invoke_subagent|view_file|read_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event PreInvocation",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ~/.agent-memory/dist/hooks/harnesses/antigravity/dispatch.js --event Stop",
        "timeout": 10
      }
    ]
  }
}
