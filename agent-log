#!/usr/bin/env python3
"""Human-facing protected-log writer for agent UIs."""

import json
import subprocess
import sys
from pathlib import Path


CLI = Path(__file__).with_name("agent-log.py")


def main():
    completed = subprocess.run(
        [sys.executable, str(CLI), *sys.argv[1:]],
        text=True,
        capture_output=True,
        check=False,
    )
    if not completed.stdout.strip():
        sys.stdout.write(completed.stderr)
        return completed.returncode
    try:
        result = json.loads(completed.stdout)
    except json.JSONDecodeError:
        sys.stdout.write(completed.stdout)
        sys.stderr.write(completed.stderr)
        return completed.returncode
    if result.get("ok"):
        if result.get("entry"):
            print(f"✓ Logged to {result['file']}")
            print("\nContent written exactly as rendered:")
            print(result["entry"])
        elif result.get("repaired"):
            print(f"✓ Repaired {result['file']}")
            print(f"Target: {result.get('target', result['repaired'])}")
        else:
            print(f"✓ Updated {result['file']}")
        return 0
    print(f"✗ Log rejected: {result.get('error', 'unknown writer error')}")
    if result.get("next_steps"):
        print(f"Next steps: {result['next_steps']}")
    return completed.returncode or 2


if __name__ == "__main__":
    raise SystemExit(main())
